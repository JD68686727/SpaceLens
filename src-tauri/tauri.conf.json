{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceLens",
  "version": "0.1.0",
  "identifier": "com.spacelens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpaceLens – Klarer Blick auf deinen Speicher",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      }
    },
    "shortDescription": "Moderner Festplatten-Analysator",
    "longDescription": "SpaceLens zeigt übersichtlich, was auf deinen Laufwerken Platz verbraucht, findet Duplikate und gibt konkrete Aufräum-Empfehlungen.",
    "category": "Utility",
    "copyright": "Copyright © 2026"
  },
  "plugins": {}
}
